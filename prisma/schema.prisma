generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Removed authentication and user models for simplified "Discover Haiti" approach

model departments {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique
  name         String
  intro        String?
  hero_url     String?
  is_published Boolean  @default(true)
  created_at   DateTime @default(now())
  cities       cities[]
}

model cities {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  department_id     String              @db.Uuid
  slug              String
  name              String
  summary           String?
  lat               Float?
  lng               Float?
  hero_url          String?
  is_published      Boolean             @default(true)
  created_at        DateTime            @default(now())
  department        departments         @relation(fields: [department_id], references: [id])
  figures           figures[]
  historical_events historical_events[]
  media             media[]
  places            places[]
  streets           streets[]

  @@unique([department_id, slug])
}

model places {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city_id                 String         @db.Uuid
  kind                    place_kind
  name                    String
  slug                    String
  description             String?
  address                 String?
  website                 String?
  lat                     Float?
  lng                     Float?
  cover_url               String?
  is_published            Boolean        @default(true)
  created_at              DateTime       @default(now())
  activity_type           activity_type?
  is_featured             Boolean        @default(false)
  opening_hours           Json?
  accessibility           String?
  best_visiting_time      String?
  directions_text         String?
  entrance_fee            String?
  guided_tours            Boolean        @default(false)
  historical_significance String?
  parking_info            String?
  transport_info          Json?
  unesco_site             Boolean        @default(false)
  media                   media[]
  city                    cities         @relation(fields: [city_id], references: [id])

  @@unique([city_id, slug])
}

model figures {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city_id          String   @db.Uuid
  name             String
  slug             String
  bio              String?
  birth_year       Int?
  death_year       Int?
  portrait_url     String?
  is_published     Boolean  @default(true)
  created_at       DateTime @default(now())
  birth_place      String?
  category         String?
  contemporaries   String?
  death_place      String?
  famous_works     String?
  full_name        String?
  legacy           String?
  lived_addresses  Json?
  monuments        Json?
  movements        String?
  quotes           Json?
  worked_addresses Json?
  city             cities   @relation(fields: [city_id], references: [id])

  @@unique([city_id, slug])
}

model media {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucket     String?  @default("public")
  path       String
  alt        String?
  place_id   String?  @db.Uuid
  city_id    String?  @db.Uuid
  created_at DateTime @default(now())
  city       cities?  @relation(fields: [city_id], references: [id])
  place      places?  @relation(fields: [place_id], references: [id])
}

// Removed business plans and subscriptions for simplified discovery-focused app

// Removed reviews and place views for simplified discovery-focused app

model streets {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city_id      String   @db.Uuid
  name         String
  named_after  String?
  story        String?
  lat          Float?
  lng          Float?
  image_url    String?
  is_published Boolean  @default(true)
  created_at   DateTime @default(now())
  city         cities   @relation(fields: [city_id], references: [id])
}

model historical_events {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city_id      String    @db.Uuid
  title        String
  description  String
  date         DateTime?
  year         Int?
  location     String?
  image_url    String?
  importance   String
  is_published Boolean   @default(true)
  created_at   DateTime  @default(now())
  city         cities    @relation(fields: [city_id], references: [id])
}

enum place_kind {
  restaurant
  beach
  landmark
  activity
  cultural_site
}

enum activity_type {
  cultural
  outdoor
  nightlife
  sports
  family
  spiritual
}
